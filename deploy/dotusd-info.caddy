dotusd.info {
	encode zstd gzip {
		minimum_length 1
		match {
			header Content-Type text/* application/javascript* application/json* application/x-ndjson*
		}
	}
	reverse_proxy 127.0.0.1:3001 {
		flush_interval -1
	}
	log {
		output stderr
	}
}

www.dotusd.info {
	redir https://dotusd.info{uri} permanent
}
