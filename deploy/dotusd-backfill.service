[Unit]
Description=One-time dotUSD history backfill from Parity archive
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
DynamicUser=true
StateDirectory=dotusd-backfill
WorkingDirectory=/opt/dotusd-info
ExecStart=/opt/dotusd-info/.venv/bin/python /opt/dotusd-info/backfill.py --database /var/lib/dotusd-backfill/archive.sqlite3 --hub-rpc https://polkadot-asset-hub-rpc.polkadot.io
Restart=no
TimeoutStartSec=infinity
Nice=15
CPUQuota=25%
MemoryMax=192M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=-/var/lib/dotusd-info
ReadWritePaths=/var/lib/dotusd-backfill
IOSchedulingClass=idle
UMask=0022

[Install]
WantedBy=multi-user.target
