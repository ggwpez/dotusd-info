[Unit]
Description=One-time dotUSD history backfill from Parity archive
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=prometheus
Group=prometheus
WorkingDirectory=/opt/dotusd-info
ExecStart=/usr/bin/python3 /opt/dotusd-info/backfill.py --database /var/lib/dotusd-backfill/archive.sqlite3
Restart=no
TimeoutStartSec=infinity
Nice=15
CPUQuota=25%
MemoryMax=192M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/var/lib/dotusd-info /var/lib/arb-peg
ReadWritePaths=/var/lib/dotusd-backfill
IOSchedulingClass=idle
UMask=0022

[Install]
WantedBy=multi-user.target
